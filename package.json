  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch:panini": "npx gulp --gulpfile ./gulpfile.js/index.js watchPanini",
    "watch:webpack": "NODE_ENV=development webpack --watch --config ./build/webpack.config.js",
    "dev": "rm -fr ./dist/* && concurrently \"npm:watch:panini\" \"npm:watch:webpack\"",
    "build:panini": "npx gulp --gulpfile ./gulpfile.js/index.js buildPanini",
    "build:images": "npx gulp --gulp-file ./gulpfile.js/index.js buildImages",
    "build:webpack": "NODE_ENV=production webpack --config ./build/webpack.config.js",
    "build": "rm -fr ./dist/* && npm run-script build:webpack && npm run-script build:panini"
  },
