{{#> showcase-group }}
    {{#*inline "showcase0"}}
            {{#>showcase}}
            <div class="uic-section uic-bg--red400 uic-color--white">
                <div class="uic-section__container">
                    <div class="uic-section__inner">
                        <div class="uic-slider">
                            <div class="uic-slider__track-container">
                            <div cla="uic-slider__controls">
                                <svg xmlns:xlink="http://www.w3.org/1999/xlink" t="Previous Slide">
                                    <use xlink:href="../images/slider/prev-arrow.svg#uic-slider__prev-arrow" />
                                </svg>
                                <svg xmlns:xlink="http://www.w3.org/1999/xlink" t="Next Slide">
                                    <use xlink:href="../images/slider/next-arrow.svg#uic-slider__next-arrow" />
                                </svg>
                            </div>
                                <div class="uic-slider__track" data-glide-el="track">
                                    <div class="uic-slider__items">
                                        <div class="uic-slider__item">
                                            <div class="uic-styleguide__slider-example__square">
                                                <div class="uic-styleguide__slider-example__number">1</div>
                                            </div>
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-styleguide__slider-example__square">
                                                <div class="uic-styleguide__slider-example__number">2</div>
                                            </div>
                                            content under the square
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-styleguide__slider-example__square">
                                                <div class="uic-styleguide__slider-example__number">3</div>
                                            </div>
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-styleguide__slider-example__square">
                                                <div class="uic-styleguide__slider-example__number">4</div>
                                            </div>
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-styleguide__slider-example__square">
                                                <div class="uic-styleguide__slider-example__number">5</div>
                                            </div>
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-styleguide__slider-example__square">
                                                <div class="uic-styleguide__slider-example__number">6</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="uic-slider__dots" data-glide-el="controls[nav]">
                                <button class="uic-slider__dot" data-glide-dir="=0"></button>
                                <button class="uic-slider__dot" data-glide-dir="=1"></button>
                                <button class="uic-slider__dot" data-glide-dir="=2"></button>
                                <button class="uic-slider__dot" data-glide-dir="=3"></button>
                                <button class="uic-slider__dot" data-glide-dir="=4"></button>
                                <button class="uic-slider__dot" data-glide-dir="=5"></button>
                                <button class="uic-slider__dot" data-glide-dir="=6"></button>
                                <button class="uic-slider__dot" data-glide-dir="=7"></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {{/showcase}}
    {{/inline}}

