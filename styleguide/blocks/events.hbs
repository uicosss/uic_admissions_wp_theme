                                        <svg xmlns:xlink="http://www.w3.org/1999/xlink" class="uic-events__event__register__arrow" viewBox="0 0 77.87 75.75">
                                            <use xlink:href="../images/events-register-arrow.svg#uic-events__event__register__arrow" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
