                                    In-Person
                                </div>
                                <div class="uic-events__event__kind">
                                    Information Session<br />
                                    And Campus Tour
                                </div>
                                <div class="uic-events__event__details">
                                    <div class="uic-events__event__name">
                                        Experience UIC
                                    </div>
                                    <div class="uic-events__event__datetime">
