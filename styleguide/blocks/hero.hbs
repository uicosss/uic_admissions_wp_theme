{{#>showcase-group}}
    {{#*inline "showcase0"}}
        {{#>showcase}}
            <div class="uic-hero">
                <div class="uic-hero__overlay">
                <div class="uic-section">
                        <div class="uic-section__container">
                            <div class="uic-section__inner">
                                <div class="uic-hero__controls">
                                    <svg xmlns:xlink="http://www.w3.org/1999/xlink" class="uic-hero__controls__autoplay" viewBox="4 4 40 40">
                                        <use xlink:href="../images/hero/hero-play-icon.svg#uic-hero__controls__autoplay--play-00" />
                                        <use xlink:href="../images/hero/hero-play-icon.svg#uic-hero__controls__autoplay--play-01" />
                                        <use xlink:href="../images/hero/hero-pause-icon.svg#uic-hero__controls__autoplay--pause-00" />
                                        <use xlink:href="../images/hero/hero-pause-icon.svg#uic-hero__controls__autoplay--pause-01" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="uic-hero__background">
                    <div class="uic-hero__slider" data-slide-transition-duration="2000">
                        <div class="uic-hero__slider__track-container">
                            <div class="uic-hero__slider__track" data-glide-el="track">
                                <div class="uic-hero__slider__items">
                                    <div class="uic-hero__slider__item glide__slide--active" style="background-image: url('../images/hero/slides/hero-background-00.jpg')">
                                        <h1 class="uic-h1">Discover</h1>
                                        <svg xmlns:xlink="http://www.w3.org/1999/xlink" class="uic-hero__text uic-hero__text--discover" viewBox="0 0 848.9 146.4">
                                            <use xlink:href="../images/hero/text/hero-text-discover.svg#uic-hero__slider__text" />
                                        </svg>
                                    </div>
                                    <div class="uic-hero__slider__item" style="background-image: url('../images/hero/slides/hero-background-01.jpg')">
                                        <h1 class="uic-h1">Discover</h1>
                                        <svg xmlns:xlink="http://www.w3.org/1999/xlink" class="uic-hero__text uic-hero__text--discover" viewBox="0 0 848.9 146.4">
                                            <use xlink:href="../images/hero/text/hero-text-discover.svg#uic-hero__slider__text" />
                                        </svg>
                                    </div>
                                    <div class="uic-hero__slider__item" style="background-image: url('../images/hero/slides/hero-background-02.jpg')">
                                        <h1 class="uic-h1">Explore</h1>
                                        <svg xmlns:xlink="http://www.w3.org/1999/xlink" class="uic-hero__text uic-hero__text--explore" viewBox="0 0 736.9 146.4">
                                            <use xlink:href="../images/hero/text/hero-text-explore.svg#uic-hero__slider__text" />
                                        </svg>
                                    </div>
                                    <div class="uic-hero__slider__item" style="background-image: url('../images/hero/slides/hero-background-03.jpg')">
                                        <h1 class="uic-h1">Connect</h1>
                                        <svg xmlns:xlink="http://www.w3.org/1999/xlink" class="uic-hero__text uic-hero__text--connect" viewBox="0 0 789.8 146.4">
                                            <use xlink:href="../images/hero/text/hero-text-connect.svg#uic-hero__slider__text" />
                                        </svg>
                                    </div>
                                    <div class="uic-hero__slider__item" style="background-image: url('../images/hero/slides/hero-background-04.jpg')">
                                        <h1 class="uic-h1">Become</h1>
                                        <svg xmlns:xlink="http://www.w3.org/1999/xlink" class="uic-hero__text uic-hero__text--become" viewBox="0 0 677 146.4">
                                            <use xlink:href="../images/hero/text/hero-text-become.svg#uic-hero__slider__text" />
                                        </svg>
                                    </div>
