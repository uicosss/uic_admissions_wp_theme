{{#>showcase}}
    <div class="uic-social-slider uic-section uic-bg--gray400">
        <div class="uic-section__container">
            <div class="uic-section__inner">
                <div class="uic-section__label"><h2 class="uic-h2" id="life" name="life">UIC Life</h2></div>
                <h3 class="uic-h3">#Discover UIC</h3>
                <div class="uic-slider">
                    <div class="uic-slider__track-container">
                        <div cla="uic-slider__controls">
                            <button class="uic-slider__prev" alt="Previous Slide">
                                <svg xmlns:xlink="http://www.w3.org/1999/xlink" alt="Prvious Slide">
                                    <use xlink:href="../images/slider/prev-arrow.svg#uic-slider__prev-arrow" />
                                </svg>
                            </button>
                            <button class="uic-slider__next" alt="Next Slide">
                                <svg xmlns:xlink="http://www.w3.org/1999/xlink" alt="Next Slide">
                                    <use xlink:href="../images/slider/next-arrow.svg#uic-slider__next-arrow" />
                                </svg>
                            </button>
                        </div>
                        <div class="uic-slider__track" data-glide-el="track">
                            <div class="uic-slider__items">
                                <div class="uic-slider__item">
                                    <div class="uic-slider__box-container">
                                        <div class="uic-slider__box" style="background-image: url('../images/social-slider/social-00.png')"></div>
                                    </div>
                                </div>
                                <div class="uic-slider__item">
                                    <div class="uic-slider__box-container">
                                        <div class="uic-slider__box" style="background-image: url('../images/social-slider/social-01.png')"></div>
                                    </div>
                                </div>
                                <div class="uic-slider__item">
                                    <div class="uic-slider__box-container">
                                        <div class="uic-slider__box" style="background-image: url('../images/social-slider/social-02.png')"></div>
                                    </div>
                                </div>
                                <div class="uic-slider__item">
                                    <div class="uic-slider__box-container">
                                        <div class="uic-slider__box" style="background-image: url('../images/social-slider/social-03.png')"></div>
                                    </div>
                                </div>
                                <div class="uic-slider__item">
                                    <div class="uic-slider__box-container">
                                        <div class="uic-slider__box" style="background-image: url('../images/social-slider/social-04.png')"></div>
                                    </div>
                                </div>
                                <div class="uic-slider__item">
                                    <div class="uic-slider__box-container">
                                        <div class="uic-slider__box" style="background-image: url('../images/social-slider/social-05.png')"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="uic-slider__dots" data-glide-el="controls[nav]">
                        <button class="uic-slider__dot" data-glide-dir="=0"></button>
                        <button class="uic-slider__dot" data-glide-dir="=1"></button>
                        <button class="uic-slider__dot" data-glide-dir="=2"></button>
                        <button class="uic-slider__dot" data-glide-dir="=3"></button>
                        <button class="uic-slider__dot" data-glide-dir="=4"></button>
                        <button class="uic-slider__dot" data-glide-dir="=5"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{{/showcase}}