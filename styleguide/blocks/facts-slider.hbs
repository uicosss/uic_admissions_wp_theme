{{#>showcase-group}}
    {{#*inline "showcase0"}}
        {{#>showcase}}
            <div class="uic-facts-slider uic-section uic-bg--red400">
                <div class="uic-section__container">
                    <div class="uic-section__inner">
                        <div class="uic-section__label"><h2 class="uic-h2" name="facts" id="facts">UIC Facts</h2></div>
                        <h3 class="uic-h3">Can we brag for a second? UIC is the BIGGEST and BEST public research university in Chicago.</h3>
                        <div class="uic-slider">
                            <div class="uic-slider__track-container">
                                <div cla="uic-slider__controls">
                                    <button class="uic-slider__prev" alt="Previous Slide">
                                        <svg xmlns:xlink="http://www.w3.org/1999/xlink" alt="Prvious Slide">
                                            <use xlink:href="../images/slider/prev-arrow.svg#uic-slider__prev-arrow" />
                                        </svg>
                                    </button>
                                    <button class="uic-slider__next" alt="Next Slide">
                                        <svg xmlns:xlink="http://www.w3.org/1999/xlink" alt="Next Slide">
                                            <use xlink:href="../images/slider/next-arrow.svg#uic-slider__next-arrow" />
                                        </svg>
                                    </button>
                                </div>
                                <div class="uic-slider__track" data-glide-el="track">
                                    <div class="uic-slider__items">
                                        <div class="uic-slider__item">
                                            <div class="uic-slider__box-container">
                                                <div class="uic-slider__box uic-facts-slider__fact">
                                                    <div class="uic-facts-slider__fact__text--normal">Illinois'</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Most Diverse</div>
                                                    <div class="uic-facts-slider__fact__text--normal">University</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-slider__box-container">
                                                <div class="uic-slider__box uic-facts-slider__fact">
                                                    <div class="uic-facts-slider__fact__text--normal">One of the most</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Trans-</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Formative</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Schools</div>
                                                    <div class="uic-facts-slider__fact__text--normal">In the nation</div>
                                                </div>
                                            </div>
                                            <div class="uic-facts-slider__fact__citation">Money</div>
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-slider__box-container">
                                                <div class="uic-slider__box uic-facts-slider__fact">
                                                    <div class="uic-facts-slider__fact__text--normal">More than 1/2 of</div>
                                                    <div class="uic-facts-slider__fact__text--normal">Undergraduates are</div>
                                                    <div class="uic-facts-slider__fact__text--focus">First-</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Generation</div>
                                                    <div class="uic-facts-slider__fact__text--normal">College students</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-slider__box-container">
                                                <div class="uic-slider__box uic-facts-slider__fact">
                                                    <div class="uic-facts-slider__fact__text--focus">No</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Tuition</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Increases</div>
                                                    <div class="uic-facts-slider__fact__text--normal">Guaranteed</div>
                                                    <div class="uic-facts-slider__fact__text--normal">For 4 years</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-slider__box-container">
                                                <div class="uic-slider__box uic-facts-slider__fact">
                                                    <div class="uic-facts-slider__fact__text--normal">UIC Students have</div>
                                                    <div class="uic-facts-slider__fact__text--focus">LESS DEBT</div>
                                                    <div class="uic-facts-slider__fact__text--normal">And</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Higher</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Salaries</div>
                                                    <div class="uic-facts-slider__fact__text--normal">Than the average</div>
                                                    <div class="uic-facts-slider__fact__text--normal">College graduate</div>
                                                </div>
                                            </div>
                                            <div class="uic-facts-slider__fact__citation">Payscale.com</div>
                                        </div>
                                        <div class="uic-slider__item">
                                            <div class="uic-slider__box-container">
                                                <div class="uic-slider__box uic-facts-slider__fact">
                                                    <div class="uic-facts-slider__fact__text--normal">One of the nation's</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Top</div>
                                                    <div class="uic-facts-slider__fact__text--focus">LGBT-</div>
                                                    <div class="uic-facts-slider__fact__text--focus">Friendly</div>
                                                    <div class="uic-facts-slider__fact__text--normal">Campuses</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="uic-slider__dots" data-glide-el="controls[nav]">
                                <button class="uic-slider__dot" data-glide-dir="=0"></button>
                                <button class="uic-slider__dot" data-glide-dir="=1"></button>
                                <button class="uic-slider__dot" data-glide-dir="=2"></button>
                                <button class="uic-slider__dot" data-glide-dir="=3"></button>
                                <button class="uic-slider__dot" data-glide-dir="=4"></button>
                                <button class="uic-slider__dot" data-glide-dir="=5"></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {{/showcase}}
    {{/inline}}
