{{#>showcase}}
    <div class="uic-section uic-video-card-slider">
        <div class="uic-section__container">
            <div class="uic-section__inner">
                <h3 class="uic-h3">Watch what it's like to live and learn at Chicago's top public research university.</h3>
                <div class="uic-slider uic-slider--inverted" data-max-page-size="3">
                    <div class="uic-slider__track-container">
                        <div cla="uic-slider__controls">
                            <button class="uic-slider__prev" alt="Previous Slide">
                                <svg xmlns:xlink="http://www.w3.org/1999/xlink" t="Previous Slide">
                                    <use xlink:href="../images/slider/prev-arrow.svg#uic-slider__prev-arrow" />
                                </svg>
                            </button>
                            <button class="uic-slider__next" alt="Next Slide">
                                <svg xmlns:xlink="http://www.w3.org/1999/xlink" alt="Next Slide">
                                    <use xlink:href="../images/slider/next-arrow.svg#uic-slider__next-arrow" />
                                </svg>
                            </button>
                        </di>
                        <div class="uic-slider__track" data-glide-el="track">
                            <div class="uic-slider__items">
                                <div class="uic-slider__item uic-slider__card">
                                    <a
                                        class="uic-video-modal__trigger"
                                        href="https://www.youtube.com/watch?v=flKoWp2CDQg"
                                        data-iframe="https://www.youtube.com/embed/flKoWp2CDQg?autoplay=1&modestbranding=1"
                                        data-thumb="../images/video-cards/video-card-00.png"
                                        data-width="560"
                                        data-height="315"
                                    >
                                        <img src="../images/video-cards/video-card-00.png" class="uic-slider__card__media" />
                                        <div class="uic-video-card-slider__card__bar"></div>
                                        <h4 class="uic-slider__card__title">
                                            Virtually anything is possible at UIC
                                        </h4>
                                    </a>    
                                    <div class="uic-slider__card__text">
                                        Three students took advantage of the tremendous resources available at UIC to
                                        create their own unforgettable colleges experience.
                                    </div>
                                </div>
                                <div class="uic-slider__item uic-slider__card">
                                    <a
                                        class="uic-video-modal__trigger"
                                        href="https://www.youtube.com/watch?v=60GxDI9OpZ4"
                                        data-iframe="https://www.youtube.com/embed/60GxDI9OpZ4?autoplay=1&modestbranding=1"
                                        data-thumb="../images/video-cards/video-card-01.png"
                                        data-width="560"
                                        data-height="315"
                                    >
                                        <img src="../images/video-cards/video-card-01.png" class="uic-slider__card__media" />
                                        <div class="uic-video-card-slider__card__bar"></div>
                                        <h4 class="uic-slider__card__title">
                                            All Things Science
                                        </h4>
                                    </a>
                                    <div class="uic-slider__card__text">
                                        Take your studies to the next level with hands-on research and real-life applications.
                                    </div>
                                </div>
                                <div class="uic-slider__item uic-slider__card">
                                    <a
                                        class="uic-video-modal__trigger"
                                        href="https://www.youtube.com/watch?v=cTLW5qzNqJc"
                                        data-iframe="https://www.youtube.com/embed/cTLW5qzNqJc?autoplay=1&modestbranding=1"
                                        data-thumb="../images/video-cards/video-card-02.png"
                                        data-width="560"
                                        data-height="315"
                                    >
                                        <img src="../images/video-cards/video-card-02.png" class="uic-slider__card__media" />
                                        <div class="uic-video-card-slider__card__bar"></div>   
                                        <h4 class="uic-slider__card__title">
                                            Why Become a Teacher?
                                        </h4>
                                    </a>
                                    <div class="uic-slider__card__text">
                                        No other job is as rewarding, challenging, and life-changing. UIC prepares teachers that make a difference.
                                    </div>
                                </div>
                                <div class="uic-slider__item uic-slider__card">
                                    <a
                                        class="uic-video-modal__trigger"
                                        href="https://www.youtube.com/watch?v=e7N0HcAdjq4"
                                        data-iframe="https://www.youtube.com/embed/e7N0HcAdjq4?autoplay=1&modestbranding=1"
                                        data-thumb="../images/video-cards/video-card-03.png"
                                        data-width="560"
                                        data-height="315"
                                    >
                                        <img src="../images/video-cards/video-card-03.png" class="uic-slider__card__media" />
                                        <div class="uic-video-card-slider__card__bar"></div>
                                        <h4 class="uic-slider__card__title">
                                            Promoting Just Resilient and Livable Communities
                                        </h4>
                                    </a>
                                    <div class="uic-slider__card__text">
                                        Want a city that works for everyone? Join the College of Urban Planning and Public Policy
                                    </div>
                                </div>
                                <div class="uic-slider__item uic-slider__card">
                                    <a
                                        class="uic-video-modal__trigger"
                                        href="https://www.youtube.com/watch?v=Rt0KvVJXpZw"
                                        data-iframe="https://www.youtube.com/embed/Rt0KvVJXpZw?autoplay=1&modestbranding=1"
                                        data-thumb="../images/video-cards/video-card-04.png"
                                        data-width="560"
                                        data-height="315"
                                    >
                                        <img src="../images/video-cards/video-card-04.png" class="uic-slider__card__media" />
                                        <div class="uic-video-card-slider__card__bar"></div>
                                        <h4 class="uic-slider__card__title">
                                            Public Health at UIC
                                        </h4>
                                    </a>
                                    <div class="uic-slider__card__text">
                                        At UIC, we work together ot eliminate health disparities around the world and
                                        right in our Chicago community.
                                    </div>
                                </div>
                                <div class="uic-slider__item uic-slider__card">
                                    <a
                                        class="uic-video-modal__trigger"
                                        href="https://www.youtube.com/watch?v=XXgqbfGt09I"
                                        data-iframe="https://www.youtube.com/embed/XXgqbfGt09I?autoplay=1&modestbranding=1"
                                        data-thumb="../images/video-cards/video-card-05.png"
                                        data-width="560"
                                        data-height="315"
                                    >
                                        <img src="../images/video-cards/video-card-05.png" class="uic-slider__card__media" />
                                        <div class="uic-video-card-slider__card__bar"></div>
                                        <h4 class="uic-slider__card__title">
                                            UIC Means Business
                                        </h4>
                                    </a>
                                    <div class="uic-slider__card__text">
                                        Learn why UIC undergraduate business program is ranked the best in Chicago.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="uic-slider__dots" data-glide-el="controls[nav]">
                        <button class="uic-slider__dot" data-glide-dir="=0"></button>
                        <button class="uic-slider__dot" data-glide-dir="=1"></button>
                        <button class="uic-slider__dot" data-glide-dir="=2"></button>
                        <button class="uic-slider__dot" data-glide-dir="=3"></button>
                        <button class="uic-slider__dot" data-glide-dir="=4"></button>
                        <button class="uic-slider__dot" data-glide-dir="=5"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{{/showcase}}